digraph G {
rankdir=LR;
__start0 [style=filled, fillcolor=pink, label="__start0"];
A [style=filled, fillcolor=orange, label=A];
F [style=filled, fillcolor=lightblue, label=F];
B1 [style=filled, fillcolor=lightgreen, label=B1];
C1 [style=filled, fillcolor=lightgreen, label=C1];
D1 [style=filled, fillcolor=lightgreen, label=D1];
B2 [style=filled, fillcolor=lightgreen, label=B2];
C2 [style=filled, fillcolor=lightgreen, label=C2];
D2 [style=filled, fillcolor=lightgreen, label=D2];
K1 [style=filled, fillcolor=lightyellow, label=K1];
L1 [style=filled, fillcolor=lightyellow, label=L1];
M1 [style=filled, fillcolor=lightyellow, label=M1];
K2 [style=filled, fillcolor=lightyellow, label=K2];
L2 [style=filled, fillcolor=lightyellow, label=L2];
M2 [style=filled, fillcolor=lightyellow, label=M2];
__start0 -> A;
A -> B1 [label="entry_alpha"];
A -> K1 [label="entry_beta"];
B1 -> C1 [label="v1"];
C1 -> D1 [label="z1"];
D1 -> B1 [label="back1"];
D1 -> B2 [label="cross_alpha"];
B2 -> C2 [label="v2"];
C2 -> D2 [label="z2"];
D2 -> B2 [label="back2"];
D2 -> B1 [label="back_alpha"];
D2 -> F;
K1 -> L1 [label="v3"];
L1 -> M1 [label="z3"];
M1 -> K1 [label="back3"];
M1 -> K2 [label="cross_beta"];
K2 -> L2 [label="v4"];
L2 -> M2 [label="z4"];
M2 -> K2 [label="back4"];
M2 -> K1 [label="back_beta"];
M2 -> F;
}
