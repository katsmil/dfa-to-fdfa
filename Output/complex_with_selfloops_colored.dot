digraph G {
rankdir=LR;
__start0 [style=filled, fillcolor=pink, label="__start0"];
A [style=filled, fillcolor=orange, label=A];
F [style=filled, fillcolor=lightblue, label=F];
B1 [style=filled, fillcolor=lightyellow, label=B1];
C1 [style=filled, fillcolor=lightyellow, label=C1];
D1 [style=filled, fillcolor=lightyellow, label=D1];
B2 [style=filled, fillcolor=lightyellow, label=B2];
C2 [style=filled, fillcolor=lightyellow, label=C2];
D2 [style=filled, fillcolor=lightyellow, label=D2];
K1 [style=filled, fillcolor=lightgreen, label=K1];
L1 [style=filled, fillcolor=lightgreen, label=L1];
M1 [style=filled, fillcolor=lightgreen, label=M1];
K2 [style=filled, fillcolor=lightgreen, label=K2];
L2 [style=filled, fillcolor=lightgreen, label=L2];
M2 [style=filled, fillcolor=lightgreen, label=M2];
__start0 -> A;
A -> B1 [label="entry_alpha"];
A -> A [label="stay"];
F -> F [label="halt"];
B1 -> C1 [label="v"];
B1 -> B1 [label="ε"];
C1 -> D1 [label="z"];
D1 -> B1 [label="u"];
D1 -> B2 [label="cross"];
D1 -> K1 [label="transit"];
B2 -> C2 [label="v"];
C2 -> D2 [label="z"];
D2 -> B2 [label="u"];
D2 -> B1 [label="back"];
D2 -> F [label="exit_alpha"];
K1 -> L1 [label="v"];
K1 -> K1 [label="retry"];
L1 -> M1 [label="z"];
M1 -> K1 [label="u"];
M1 -> K2 [label="cross"];
K2 -> L2 [label="v"];
L2 -> M2 [label="u"];
L2 -> L2 [label="v"];
M2 -> K2 [label="z"];
M2 -> K1 [label="back"];
M2 -> F [label="exit_beta"];
}
