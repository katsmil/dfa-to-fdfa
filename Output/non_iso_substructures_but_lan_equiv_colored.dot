digraph G {
rankdir=LR;
__start0 [style=filled, fillcolor=pink, label="__start0"];
q0 [style=filled, fillcolor=orange, label=q0];
q1 [style=filled, fillcolor=lightgreen, label=q1];
q2 [style=filled, fillcolor=lightyellow, label=q2];
q3 [style=filled, fillcolor=lightgreen, label=q3];
qF [style=filled, fillcolor=lightblue, label=qF];
__start0 -> q0;
q0 -> q1 [label="a"];
q0 -> q2 [label="b"];
q1 -> q3 [label="a"];
q1 -> q1 [label="b"];
q2 -> q2 [label="a"];
q2 -> qF [label="b"];
q3 -> q1 [label="a"];
q3 -> qF [label="b"];
qF -> qF [label="a,b"];
}
