digraph G {
rankdir=LR;
__start0 [style=filled, fillcolor=orange, label="__start0"];
A [style=filled, fillcolor=lightyellow, label=A];
F [style=filled, fillcolor=lightblue, label=F];
B1 [style=filled, fillcolor=lightgreen, label=B1];
C1 [style=filled, fillcolor=lightgreen, label=C1];
D1 [style=filled, fillcolor=lightgreen, label=D1];
B2 [style=filled, fillcolor=lightgreen, label=B2];
C2 [style=filled, fillcolor=lightgreen, label=C2];
D2 [style=filled, fillcolor=lightgreen, label=D2];
__start0 -> A;
A -> B1 [label="entry_alpha"];
B1 -> C1 [label="v"];
C1 -> D1 [label="z"];
D1 -> B1 [label="u"];
D1 -> B2 [label="cross"];
B2 -> C2 [label="v"];
C2 -> D2 [label="z"];
D2 -> B2 [label="u"];
D2 -> B1 [label="back"];
D2 -> F [label="exit_alpha"];
}
