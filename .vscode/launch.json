{
    "configurations": [
        {
            "name": "Determine iso between regions found by dominator theory",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dominator_region_isomorphism.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}",
                "${input:nodeName}"
            ]
        },
        {
            "name": "Dynamically determine startnode for dominator search algo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/root_agnostic_dominator_region_isomorphism.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "Calculate Dominator Regions by Virtual Node",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dominator_virtual_node.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "[NX IsIsomorphic]Dominator Regons by Virtual Node",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/isomorphism_detector.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "Iso check with Natural Loops",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/natural_loop_isomorphism.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "MINIMIZATION",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/minimization[PoC].py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "TEST",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/TEST.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "inputFile",
            "type": "promptString",
            "description": "input file path (bijv. input/<filename>.dot)",
            "default": "input/scc_single_preheader_entry.dot"
        },
        {
            "id": "nodeName",
            "type": "promptString",
            "description": "Node name (bijv. P1)",
            "default": "P1"
        }
    ]
}