{
    "configurations": [
        {
            "name": "EquivalenceClosure",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/EquivalenceClosure/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "Benchmark",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/benchmark/benchmark.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "No EquivalenceClosure - hybrid frontiers",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/No_EquivalenceClosure/hybrid_frontiers/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "No EquivalenceClosure - exclusive frontiers",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/No_EquivalenceClosure/exclusive_frontiers/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "(Optimized) No EquivalenceClosure - exclusive frontiers",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/No_EquivalenceClosure/exclusive_frontiers/optimized/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "inputFile",
            "type": "promptString",
            "description": "input file path (bijv. input/<filename>.dot)",
            "default": "input/scc_single_preheader_entry.dot"
        },
        {
            "id": "nodeName",
            "type": "promptString",
            "description": "Node name (bijv. P1)",
            "default": "P1"
        }
    ]
}