{
    "configurations": [
        {
            "name": "🔬 Equivalence Closure",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/equivalence_closure/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 Equivalence Closure (Optimized)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/equivalence_closure/optimized/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 No Equivalence Closure - Exclusive (Optimized) [RECOMMENDED]",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/no_equivalence_closure/exclusive_frontiers/optimized/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 No Equivalence Closure - Exclusive",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/no_equivalence_closure/exclusive_frontiers/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 No Equivalence Closure - Hybrid Frontiers",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/no_equivalence_closure/hybrid_frontiers/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "📊 Benchmark (beide varianten)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/benchmark/benchmark.py",
            "console": "integratedTerminal"
        },
        {
            "name": "🧪 Language Preservation Tester",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/language_preservation/language_preservation.py",
            "console": "integratedTerminal",
            "args": [
                "${input:lp_orig}",
                "${input:lp_fact}",
                "${input:lp_string}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "inputFile",
            "type": "promptString",
            "description": "input file path (bijv. input/<filename>.dot)",
            "default": "input/scc_single_preheader_entry.dot"
        },
        {
            "id": "nodeName",
            "type": "promptString",
            "description": "Node name (bijv. P1)",
            "default": "P1"
        },
        {
            "id": "lp_orig",
            "type": "promptString",
            "description": "Original DOT file (bijv. input/joshua/differentEntries.dot)",
            "default": "input/joshua/differentEntries.dot"
        },
        {
            "id": "lp_fact",
            "type": "promptString",
            "description": "Factored DOT file (bijv. output/differentEntries_factorized.dot)",
            "default": "output/differentEntries_factorized.dot"
        },
        {
            "id": "lp_string",
            "type": "promptString",
            "description": "Input string (bijv. axxa or 'a x x a' for spaced tokens)",
            "default": "axxa"
        }
    ]
}