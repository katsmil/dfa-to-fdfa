{
    "configurations": [
        {
            "name": "🔬 Equivalence Closure (Not Optimized)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/equivalence_closure/not_optimized/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 Equivalence Closure (Optimized)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/equivalence_closure/optimized/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 Equivalence Closure (exclusive frontiers)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/approaches/equivalence_closure/exclusive_frontiers/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 No Equivalence Closure - Exclusive (Optimized + Fases Combined)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/approaches/no_equivalence_closure/exclusive_frontiers/optimized_fases_combined/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 No Equivalence Closure - Exclusive (Optimized + Fases Separated)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/approaches/no_equivalence_closure/exclusive_frontiers/optimized_fases_separated/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 No Equivalence Closure - Exclusive (Not Optimized)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/no_equivalence_closure/exclusive_frontiers/not_optimized/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "🔬 No Equivalence Closure - Hybrid Frontiers",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/approaches/no_equivalence_closure/hybrid_frontiers/main.py",
            "console": "integratedTerminal",
            "args": [
                "${input:inputFile}"
            ]
        },
        {
            "name": "📊 Benchmark (beide varianten)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/benchmark/benchmark.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "🧪 Language Preservation - Single String",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/language_preservation/random_language_preservation.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:lp_orig}",
                "${input:lp_fact}",
                "${input:lp_string}"
            ]
        },
        {
            "name": "🧪 Language Preservation - Random",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/language_preservation/random_language_preservation.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:lp_orig}",
                "${input:lp_fact}"
            ]
        },
        {
            "name": "🧪 Language Preservation - Targeted",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/language_preservation/targeted_language_preservation.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:lp_orig}",
                "${input:lp_fact}"
            ]
        },
        {
            "name": "🧪 Language Preservation - Targeted (verbose)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/language_preservation/targeted_language_preservation.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:lp_orig}",
                "${input:lp_fact}",
                "--verbose"
            ]
        },
        {
            "name": "🧪 Language Preservation - Targeted (subset)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/language_preservation/targeted_language_preservation.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:lp_orig}",
                "${input:lp_fact}",
                "--states",
                "${input:lp_states}"
            ]
        },
        {
            "name": "🧪 Language Preservation - Targeted (subset + verbose)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/language_preservation/targeted_language_preservation.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "${input:lp_orig}",
                "${input:lp_fact}",
                "--states",
                "${input:lp_states}",
                "--verbose"
            ]
        }
    ],
    "inputs": [
        {
            "id": "inputFile",
            "type": "promptString",
            "description": "input file path (bijv. input/<filename>.dot)",
            "default": "input/scc_single_preheader_entry.dot"
        },
        {
            "id": "nodeName",
            "type": "promptString",
            "description": "Node name (bijv. P1)",
            "default": "P1"
        },
        {
            "id": "lp_orig",
            "type": "promptString",
            "description": "Original DOT file (bijv. input/joshua/differentEntries.dot)",
            "default": "input/joshua/differentEntries.dot"
        },
        {
            "id": "lp_fact",
            "type": "promptString",
            "description": "Factored DOT file (bijv. output/differentEntries_factorized.dot)",
            "default": "output/differentEntries_factorized.dot"
        },
        {
            "id": "lp_string",
            "type": "promptString",
            "description": "Input string (bijv. axxa or 'a x x a' for spaced tokens)",
            "default": "axxa"
        },
        {
            "id": "lp_states",
            "type": "promptString",
            "description": "Comma-separated state names to test (e.g. q0,q3,q7)",
            "default": "q0,q1"
        }
    ]
}