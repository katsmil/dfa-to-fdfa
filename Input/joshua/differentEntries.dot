digraph differentEntries {
  __start0 -> q0;

  q0 -> a1 [label="a"];
  q0 -> b2 [label="b"];

  a6 -> qf [label="a"];
  b6 -> qf [label="b"];
  qf [shape=doublecircle];

  // Component een
  a1 -> a2 [label="x"];
  a2 -> a3 [label="x"];
  a3 -> a4 [label="x"];
  a4 -> a5 [label="x"];
  a5 -> a6 [label="x"];
  a6 -> a1 [label="x"];

  // Component twee
  b1 -> b2 [label="x"];
  b2 -> b3 [label="x"];
  b3 -> b4 [label="x"];
  b4 -> b5 [label="x"];
  b5 -> b6 [label="x"];
  b6 -> b1 [label="x"];

}
