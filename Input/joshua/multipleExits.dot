digraph multipleExits {
  __start0 -> q0;

  q0 -> z1 [label="a"];
  q0 -> z2 [label="b"];

  x1 -> a1 [label="a"];
  y1 -> qf [label="a"];
  a1 -> qf [label="a"];

  x2 -> b1 [label="b"];
  y2 -> qf [label="b"];
  b1 -> qf [label="b"];

  qf [shape=doublecircle];

  // Component een
  z1 -> x1 [label="x"];
  z1 -> y1 [label="y"];
  x1 -> y1 [label="y"];
  y1 -> z1 [label="z"];

  // Component twee
  z2 -> x2 [label="x"];
  z2 -> y2 [label="y"];
  x2 -> y2 [label="y"];
  y2 -> z2 [label="z"];

}
