digraph G {
  rankdir=LR;
  node [fontname="Arial"];

  __start0 [label="" shape=none width=0 height=0];
  __start0 -> A;
  A [shape=circle, style=filled, fillcolor=lightgreen];
  F [shape=doublecircle, style=filled, fillcolor=lightpink];

  // --- SCC 1: Alpha Groep (De eerste complexe component) ---
  // Twee onderling verbonden lussen
  B1 -> C1 [label="v"];
  C1 -> D1 [label="z"];
  D1 -> B1 [label="u"];
  
  B2 -> C2 [label="v"];
  C2 -> D2 [label="z"];
  D2 -> B2 [label="u"];

  D1 -> B2 [label="w"];
  D2 -> B1 [label="back"];

  // --- SCC 2: Beta Groep (De tweede complexe component, Isomorf) ---
  // Ook twee onderling verbonden lussen
  K1 -> L1 [label="v"];
  L1 -> M1 [label="z"];
  M1 -> K1 [label="u"];
  
  K2 -> L2 [label="v"];
  L2 -> M2 [label="z"];
  M2 -> K2 [label="u"];

  M1 -> K2 [label="w"];
  M2 -> K1 [label="back"];

  // --- De verbindingen die de structuur bepalen ---
  A -> B1 [label="entry_alpha"];
  A -> K1 [label="entry_beta"];

  // Exits naar het einde
  D2 -> F [label="exit_alpha"];
  M2 -> F [label="exit_beta"];
}