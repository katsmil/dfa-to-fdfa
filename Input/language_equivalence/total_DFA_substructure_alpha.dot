digraph G_binary {
    rankdir=LR;
    node [fontname="Arial", style=filled];
    
    __start0 [label="" shape=none width=0 height=0];
    __start0 -> A1;
    
    A1;
    B1;
    C1;

    A1 -> B1 [label="0"];
    B1 -> C1 [label="0"];
    A1 -> C1 [label="1"];
    B1 -> C1 [label="1"]; 
    C1 -> A1 [label="1"]; 

    C1 -> sink
    sink -> sink [label="1"];
    sink -> sink [label="0"];
}
