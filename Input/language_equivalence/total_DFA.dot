digraph G_binary {
    rankdir=LR;
    node [fontname="Arial", style=filled];

    __start0 [label="" shape=none width=0 height=0];
    __start0 -> Entry;

    Entry [fillcolor=lightgrey];
    A1;
    B1;
    C1;
    A2;
    B2;
    F [shape=doublecircle, fillcolor=lightpink, label="ACCEPT"];

    A1 -> B1 [label="0"];
    B1 -> C1 [label="0"];
    A1 -> C1 [label="1"]
    B1 -> C1 [label="1"]; 
    C1 -> A1 [label="1"];  // origineel 2 → 0

    A2 -> B2 [label="0"];  // origineel 0
    A2 -> B2 [label="1"];  // origineel 1
    B2 -> A2 [label="0"];  // origineel 2 → 0

    Entry -> A1 [label="1"]; // origineel 1
    Entry -> A2 [label="0"]; // origineel 2 → 0

    C1 -> F [label="0"];     // origineel 2 → 0
    B2 -> F [label="1"];     // origineel 1
}
