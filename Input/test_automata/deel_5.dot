digraph G {
  rankdir=LR;
  node [fontname="Arial", style=filled]; // Standaard stijl voor alle knopen

  __start0 [label="" shape=none width=0 height=0];
  __start0 -> A;
  A [fillcolor=lightgreen];
  F [shape=doublecircle, fillcolor=lightpink];

  // --- REGIO ALPHA (Grijze tint) ---
  node [fillcolor="#eeeeee"]; 
  a_B1 [label="B1"]; a_C1 [label="C1"]; a_D1 [label="D1"];
  a_B2 [label="B2"]; a_C2 [label="C2"]; a_D2 [label="D2"];

  a_B1 -> a_C1 [label="v"];
  a_C1 -> a_D1 [label="z"];
  a_D1 -> a_B1 [label="u"];
  
  a_B2 -> a_C2 [label="v"];
  a_C2 -> a_D2 [label="z"];
  a_D2 -> a_B2 [label="u"];

  a_D1 -> a_B2 [label="cross"];
  a_D2 -> a_B1 [label="back"];
  a_B1 -> a_B1 [label="ε"];

  // --- REGIO BETA (Blauwe tint) ---
  node [fillcolor="#e1f5fe"];
  b_K1 [label="K1"]; b_L1 [label="L1"]; b_M1 [label="M1"];
  b_K2 [label="K2"]; b_L2 [label="L2"]; b_M2 [label="M2"];

  b_K1 -> b_L1 [label="v"];
  b_L1 -> b_M1 [label="z"];
  b_M1 -> b_K1 [label="u"];
  
  b_K2 -> b_L2 [label="v"];
  b_L2 -> b_M2 [label="u"];
  b_M2 -> b_K2 [label="z"];

  b_M1 -> b_K2 [label="cross"];
  b_M2 -> b_K1 [label="back"];
  b_K1 -> b_K1 [label="ε"];
  b_L2 -> b_L2 [label="v"];
  
  // ---REGIO ACYCLISCH ---
  node [fillcolor="#FFFF00"];
  1; 2; 3;
  11;12;13;14;15;16;17
  111;112;113;114;116
  1 -> 2 [label="u"];
  1 -> 3 [label="v"];
  2 -> 3 [label="w"];
  3 -> 5 [label="z"];
  5 -> 7 [label="i"];
  
  11 -> 12 [label="u"];
  11 -> 13 [label="v"];
  12 -> 14 [label="w"];
  13 -> 15 [label="z"];
  14 -> 16 [label="i"];
  15 -> 17 [label="i"];
  
  111 -> 112 [label="u"];
  111 -> 113 [label="v"];
  112 -> 114 [label="w"];
  113 -> 112 [label="z"];
  114 -> 116 [label="i"];

  // --- Verbindingen ---
  node [fillcolor=white]; // Reset kleur voor rest
  A -> a_B1 [label="entry_alpha"];
  a_D1 -> b_K1 [label="transit"];
  a_D2 -> F [label="exit_alpha"];
  a_D2 -> 1 [label="x"];
  
  a_D2 -> 111 [label="q"];
 
  17 -> F [label="$"];
  16 -> F [label="@"];
  7 -> F [label="#"];
  116 -> F [label="!"];
  
  b_M2 -> F [label="exit_beta"];
  b_M2 -> 11 [label="y"];
  A  -> A  [label="stay"];
  F  -> F  [label="halt"];
}