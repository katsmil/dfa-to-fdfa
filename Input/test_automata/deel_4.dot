digraph G {
    label=<
    <b>Toelichting:</b><br/>
    Deze cyclische minimale DFA toont drie cyclische substructuren die herhalend zijn<br/>
    te weten: (b1,c1,d1), (k1,l1,m1) en (r1,s1,t1).<br/>
    Daarnaast bestaat er een acyclische staart in deze automaat, welke is aangegeven in geel.<br/>
    Hiervoor geldt dat de structuur overeenkomt tussen de verzameling toestanden:<br/>
    (1,2,3,4) en (11,12,13,14)
    
  >;
  labelloc="t";
  fontsize=30;

  rankdir=LR;
  node [fontname="Arial", style=filled]; // Standaard stijl voor alle knopen

  __start0 [label="" shape=none width=0 height=0];
  __start0 -> A;
  A [fillcolor=lightgreen];
  F [shape=doublecircle, fillcolor=lightpink];


  // --- REGIO ALPHA (Grijze tint) ---
  node [fillcolor="#eeeeee"]; 
  a_B1 [label="B1"]; a_C1 [label="C1"]; a_D1 [label="D1"];
  a_B2 [label="B2"]; a_C2 [label="C2"]; a_D2 [label="D2"];
  a_C1a [label="C1a"]

  a_B1 -> a_C1 [label="v"];
  a_C1 -> a_D1 [label="z"];
  a_C1 -> a_C1a [label="g"];
  a_C1a -> a_C1 [label="i"];
  a_D1 -> a_B1 [label="u"];
  
  a_B2 -> a_C2 [label="v"];
  a_C2 -> a_D2 [label="z"];
  a_D2 -> a_B2 [label="u"];

  a_D1 -> a_B2 [label="cross"];
  a_D2 -> a_B1 [label="back"];
  a_B1 -> a_B1 [label="ε"];

  // --- REGIO BETA (Blauwe tint) ---
  node [fillcolor="#e1f5fe"];
  b_K1 [label="K1"]; b_L1 [label="L1"]; b_M1 [label="M1"];
  b_K2 [label="K2"]; b_L2 [label="L2"]; b_M2 [label="M2"];
  b_L1a [label="L1a"]

  b_K1 -> b_L1 [label="v"];
  b_L1 -> b_M1 [label="z"];
  b_L1 -> b_L1a [label="g"];
  b_L1a -> b_L1 [label="h"];
  b_L1a -> b_K1 [label="$"];
  b_M1 -> b_K1 [label="u"];
  b_M1 -> b_L1a [label="$"];
  
  b_K2 -> b_L2 [label="v"];
  b_L2 -> b_M2 [label="u"];
  b_M2 -> b_K2 [label="z"];

  b_M1 -> b_K2 [label="cross"];
  b_M2 -> b_K1 [label="back"];
  b_K1 -> b_K1 [label="ε"];
  b_L2 -> b_L2 [label="v"];
 
  
  // --- REGIO CHARLIE (Oranje tint) ---
  node [fillcolor="#FFA500"];
  b_M2 -> c_R1 [label="transit"];
  c_R1 [label="R1"]; c_S1 [label="S1"]; c_T1 [label="T1"];
  c_S1a [label="S1a"]
  c_R1 -> c_R1 [label="ε"]
  c_R1 -> c_S1 [label="v"];
  c_S1 -> c_T1 [label="z"];
  c_S1 -> c_S1a [label="g"];
  c_S1a -> c_S1 [label="o"];
  c_T1 -> c_R1 [label="u"];
  c_T1 -> F [label="q"];
  
   
  // ---REGIO ACYCLISCH ---
  node [fillcolor="#FFFF00"];
  1; 2; 3; 4;5;
  11;12;13;14;15;
  1 -> 2 [label="u"];
  2 -> 3 [label="v"];
  3 -> 4 [label="w"];
  3 -> 2 [label="@"];
  4 -> 5 [label="$"];
  
  11 -> 12 [label="u"];
  12 -> 13 [label="v"];
  13 -> 14 [label="w"];
  13 -> 12 [label="@"];
  14 -> 15 [label="$"];

  c_T1 -> 13 [label="i"];
  // --- Verbindingen ---
  node [fillcolor=white]; // Reset kleur voor rest
  A -> a_B1 [label="entry_alpha"];
  a_D1 -> b_K1 [label="transit"];
  a_D2 -> F [label="exit_alpha"];
  a_D2 -> 1 [label="x"];
 
  15 -> F [label="z"];
  5 -> F [label="g"];
  
  b_M2 -> F [label="exit_beta"];
  b_M2 -> 11 [label="y"];
  A  -> A  [label="stay"];
  F  -> F  [label="halt"];
}