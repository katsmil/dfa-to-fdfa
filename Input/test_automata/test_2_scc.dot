digraph SCC_q1_q3 {
    rankdir=LR;

    __start0 [shape=none, label=""];
    __start0 -> q1;

    q1 [fillcolor=lightblue];
    q3 [shape=doublecircle, fillcolor=lightblue, label="ACCEPT"];
    sink [shape=box, style=filled, fillcolor=lightgrey];

    # Interne overgangen
    q1 -> q3 [label=a];
    q1 -> q1 [label=b];
    q3 -> q1 [label=a];

    # Uitgaande overgang naar buiten SCC
    q3 -> sink [label=b];

    # Sink zelflus
    sink -> sink [label="a,b"];
}
