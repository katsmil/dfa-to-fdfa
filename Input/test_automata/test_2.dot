digraph G_minimal {
    rankdir=LR;
    node [fontname="Arial", style=filled];
    
    __start0 [label="" shape=none width=0 height=0];
    __start0 -> q0;
    
    q0 [fillcolor=lightgrey];
    q1 [fillcolor=lightblue];
    q2 [fillcolor=lightgreen];
    q3 [shape=doublecircle, fillcolor=lightblue, label="ACCEPT"];
    qF [shape=doublecircle, fillcolor=lightpink, label="ACCEPT"];
    
    q0 -> q1 [label="a"];
    q0 -> q2 [label="b"];
    q1 -> q3 [label="a"];
    q1 -> q1 [label="b"];
    q3 -> q1 [label="a"];
    q3 -> qF [label="b"];
    q2 -> q2 [label="a"];
    q2 -> qF [label="b"];
    qF -> qF [label="a,b"];
}
