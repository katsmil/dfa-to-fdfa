digraph multipleExits2 {
  __start0 -> q0;

  q0 -> a1 [label="a"];
  q0 -> b1 [label="b"];

  ay -> qf [label="a"];
  az -> qf [label="c"];

  by -> qf [label="b"];
  bz -> qf [label="d"];

  qf [shape=doublecircle];

  // Component een
  a1 -> a2 [label="x"];
  a2 -> a3 [label="x"];
  a3 -> a4 [label="x"];
  a4 -> a5 [label="x"];
  a5 -> a1 [label="x"];
  a4 -> ay [label="y"];
  a5 -> az [label="z"];

  // Component twee
  b1 -> b2 [label="x"];
  b2 -> b3 [label="x"];
  b3 -> b4 [label="x"];
  b4 -> b5 [label="x"];
  b5 -> b1 [label="x"];
  b4 -> by [label="y"];
  b5 -> bz [label="z"];

}
