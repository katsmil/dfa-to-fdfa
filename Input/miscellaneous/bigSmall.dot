digraph bigSmall {
  __start0 -> q0;

  q0 -> a1 [label="a"];
  q0 -> b1 [label="b"];
  q0 -> e1 [label="c"];

  // Component een
  a1 -> a2 [label="1"];
  a2 -> a3 [label="2"];
  a3 -> c1 [label="3"];

  // Component twee
  c1 -> c2 [label="1"];
  c2 -> c3 [label="2"];
  c3 -> af [label="3"];

  // Component drie
  b1 -> b2 [label="1"];
  b2 -> b3 [label="2"];
  b3 -> d1 [label="3"];

  // Component vier
  d1 -> d2 [label="1"];
  d2 -> d3 [label="2"];
  d3 -> bf [label="3"];

  // Component vijf
  e1 -> e2 [label="1"];
  e2 -> e3 [label="2"];
  e3 -> ef [label="3"];

  // accepting state, asymmetrisch
  af -> qf [label="a"]
  bf -> qf [label="b"]
  ef -> qf [label="c"]

  qf [shape=doublecircle];
}
