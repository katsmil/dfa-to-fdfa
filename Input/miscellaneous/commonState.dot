digraph commonState {
  __start0 -> q0;

  q0 -> a1 [label="a"];
  q0 -> b1 [label="b"];
  
  xx -> q0 [label="r"];


  // Component een
  a1 -> a2 [label="1"];
  a2 -> a3 [label="2"];
  a3 -> af [label="3"];
  
  a1 -> xx [label="0"];
  a2 -> xx [label="0"];
  a3 -> xx [label="0"];
 
 
  // Component twee
  b1 -> b2 [label="1"];
  b2 -> b3 [label="2"];
  b3 -> bf [label="3"]; 
  
  b1 -> xx [label="0"];
  b2 -> xx [label="0"];
  b3 -> xx [label="0"];
  
  
  //
  af -> qf [label="a"];
  bf -> qf [label="b"];
  qf -> q0 [label="r"];
  qf [shape=doublecircle];
}
