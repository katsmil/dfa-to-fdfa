digraph G {
    rankdir=LR;

    // Startnode
    __start0 [label="" shape="none" width=0 height=0];
    __start0 -> A;

    // Nodes
    A [shape=circle, style=filled, fillcolor=lightgreen];   // Start
    F [shape=doublecircle, style=filled, fillcolor=lightpink]; // Final state

    // Eerste substructuur (cyclus 1)
    B1 [shape=circle];
    C1 [shape=circle];
    D1 [shape=circle];

    A -> B1 [label="x"];
    B1 -> C1 [label="v"];
    C1 -> D1 [label="z"];
    D1 -> B1 [label="w"];

    // Tweede substructuur (cyclus 2, gedragsisomorf aan cyclus 1)
    B2 [shape=circle];
    C2 [shape=circle];
    D2 [shape=circle];

    A -> B2 [label="y"];
    B2 -> C2 [label="v"];
    C2 -> D2 [label="z"];
    D2 -> B2 [label="w"];

    // Losse overgang naar final state
    D1 -> F [label="f"];
    D2 -> F [label="g"];
}
