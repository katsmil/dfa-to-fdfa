digraph G {
  rankdir=LR;
  __start0 [label="" shape=none width=0 height=0];
  __start0 -> A;
  A [shape=circle, style=filled, fillcolor=lightgreen];
  F [shape=doublecircle, style=filled, fillcolor=lightpink];

  P1 [label="P1\n(preheader1)" shape=box style=filled fillcolor=lightyellow];
  P2 [label="P2\n(preheader2)" shape=box style=filled fillcolor=lightyellow];

  B1; C1; D1;
  B2; C2; D2;

  // buitenpad naar aparte preheaders
  A -> P1 [label="x1"];
  A -> P2 [label="x2"];

  // preheaders naar loop-headers
  P1 -> B1 [label="y1"];
  P2 -> B2 [label="y2"];

  // loop 1
  B1 -> C1 [label="v"];
  C1 -> D1 [label="z"];
  D1 -> B1 [label="w"];

  // loop 2
  B2 -> C2 [label="v"];
  C2 -> D2 [label="z"];
  D2 -> B2 [label="w"];

  // kruispaden (cross edges) tussen loops, mogen blijven
  D1 -> B2 [label="p"];
  D2 -> B1 [label="q"];

  // uitgangen naar exit
  D1 -> F [label="f"];
  D2 -> F [label="g"];
}
