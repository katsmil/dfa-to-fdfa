digraph G {
  rankdir=LR;
  node [fontname="Arial", style=filled]; // Standaard stijl voor alle knopen

  __start0 [label="" shape=none width=0 height=0];
  __start0 -> A;
  A [fillcolor=lightgreen];
  F [shape=doublecircle, fillcolor=lightpink];

  // --- REGIO ALPHA (Grijze tint) ---
  node [fillcolor="#eeeeee"]; 
  a_B1 [label="B1"]; a_C1 [label="C1"]; a_D1 [label="D1"];
  a_B2 [label="B2"]; a_C2 [label="C2"]; a_D2 [label="D2"];
  a_C1a [label="C1a"]

  a_B1 -> a_C1 [label="v"];
  a_C1 -> a_D1 [label="z"];
  a_C1 -> a_C1a [label="g"];
  a_C1a -> a_C1 [label="i"];
  a_D1 -> a_B1 [label="u"];
  
  a_B2 -> a_C2 [label="v"];
  a_C2 -> a_D2 [label="z"];
  a_D2 -> a_B2 [label="u"];

  a_D1 -> a_B2 [label="cross"];
  a_D2 -> a_B1 [label="back"];
  a_B1 -> a_B1 [label="ε"];

  // --- REGIO BETA (Blauwe tint) ---
  node [fillcolor="#e1f5fe"];
  b_K1 [label="K1"]; b_L1 [label="L1"]; b_M1 [label="M1"];
  b_K2 [label="K2"]; b_L2 [label="L2"]; b_M2 [label="M2"];
  b_L1a [label="L1a"]

  b_K1 -> b_L1 [label="v"];
  b_L1 -> b_M1 [label="z"];
  b_L1 -> b_L1a [label="g"];
  b_L1a -> b_L1 [label="h"];
  b_M1 -> b_K1 [label="u"];
  
  b_K2 -> b_L2 [label="v"];
  b_L2 -> b_M2 [label="u"];
  b_M2 -> b_K2 [label="z"];

  b_M1 -> b_K2 [label="cross"];
  b_M2 -> b_K1 [label="back"];
  b_K1 -> b_K1 [label="ε"];
  b_L2 -> b_L2 [label="v"];
  
  // ---REGIO ACYCLISCH ---
  node [fillcolor="#FFFF00"];
  1; 2; 3; 4;
  11;12;13;14
  1 -> 2 [label="u"];
  2 -> 3 [label="v"];
  3 -> 4 [label="w"];
  
  11 -> 12 [label="u"];
  12 -> 13 [label="v"];
  13 -> 14 [label="w"];

  // --- Verbindingen ---
  node [fillcolor=white]; // Reset kleur voor rest
  A -> a_B1 [label="entry_alpha"];
  a_D1 -> b_K1 [label="transit"];
  a_D2 -> F [label="exit_alpha"];
  a_D2 -> 1 [label="x"];
 
  14 -> F [label="z"];
  4 -> F [label="g"];
  
  b_M2 -> F [label="exit_beta"];
  b_M2 -> 11 [label="y"];
  A  -> A  [label="stay"];
  F  -> F  [label="halt"];
}