digraph G {
  rankdir=LR;
  node [fontname="Arial", style=filled]; // Standaard stijl voor alle knopen

  __start0 [label="" shape=none width=0 height=0];
  __start0 -> a_B1 [label="entry_alpha"];
  
  __start1 [label="" shape=none width=0 height=0];

  // --- REGIO 1 (Grijze tint) ---
  node [fillcolor="#eeeeee"]; 
  a_B1 [label="Call_a_1"]; a_D1 [label="D1"];
  a_B2 [label="B2"]; 

  a_B1 -> a_D1 [label="z"];
  a_D1 -> a_B1 [label="u"];
  
  a_D1 -> a_B2 [label="cross"];
  a_D1 -> a_K1 [label="transit"];
  
  // --- REGIO 2 (Grijze tint) ---
  node [fillcolor="#eeeeee"]; 
  a_K1 [label="Call_a_2"]; a_M1 [label="M1"];
  a_K2 [label="K2"]; 

  a_K1 -> a_M1 [label="z"];
  a_M1 -> a_K1 [label="u"];
  
  a_M1 -> a_K2 [label="cross"];
  
  // --- SubAutomaton ---
  a1 [label="a1"]; a2 [label="a2"];
  a1 -> a1 [label="ε"];
  a1 -> a2 [label="v"]
}