digraph G {
  rankdir=LR;
  node [fontname="Arial", style=filled]; // Standaard stijl voor alle knopen
  __start0 [label="" shape=none width=0 height=0];
  __start0 -> a1 [label="entry_alpha"];
  
  __start1 [label="" shape=none width=0 height=0];
  // --- REGIO 1 (Grijze tint) ---
  node [fillcolor="#eeeeee"]; 
  a1 [label="b1"]; a2 [label="c1"];
  a3 [label="d1"]; a_B2 [label="b2"]
  a1 -> a1 [label="ε"];
  a1 -> a2 [label="v"]
  a2 -> a3 [label="z"]
  a3 -> a1 [label="u"]
  a3 -> a_K1 [label="transit"];
  a3 -> a_B2 [label="cross"]; 
  
  // --- REGIO 2 (Grijze tint) ---
  node [fillcolor="#eeeeee"]; 
  a_K1 [label="RC"];
  a_K2 [label="K2"]; 
  
  a_K1 -> a_K2 [label="cross"];
  
  // --- Dashed lines ---
//  a_B1 -> a1 [style=dashed];
//  a3 -> a_B1 [style=dashed];
  
  a_K1 -> a1 [style=dashed];
  a3 -> a_K1 [style=dashed];
}