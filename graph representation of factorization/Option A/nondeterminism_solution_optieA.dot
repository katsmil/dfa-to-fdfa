digraph G {
  rankdir=LR;
  node [fontname="Arial", style=filled]; // Standaard stijl voor alle knopen
  __start0 [label="" shape=none width=0 height=0];
  __start0 -> a_B1[label="entry"];
  
  __start1 [label="" shape=none width=0 height=0];
  __start1 -> a1;
  
  __start1 [label="" shape=none width=0 height=0];
  // --- REGIO 1 (Grijze tint) ---
  node [fillcolor="#eeeeee"]; 
  a_B1 [shape=box, fillcolor=orange,label="CALL: RC_B1"];
  a_B1_ret [shape=box, fillcolor=orange,label="RC_return_B1_a4"];
  
  a_B2 [label="B2"]; 
  
  a_B1_ret -> a_B2 [label="cross"];
  a_B1_ret -> a_K1 [label="transit"];
  
  // --- REGIO 2 (Grijze tint) ---
  a_K1 [shape=box, fillcolor=orange, label="CALL: RC_K1"];
  a_K1_ret_a3 [shape=box, fillcolor=orange, label="RC_return_K1_a3"];
  a_K1_ret_a4 [shape=box, fillcolor=orange, label="RC_return_K1_a4"];
  a_K2 [label="K2"]; 
  
  
  a_K1_ret_a4 -> a_K2 [label="cross"];
  a_K1_ret_a4 -> L1a [label="$"];
  a_K1_ret_a3 -> a_K1 [label="$"];
  a_K1_ret_a3 -> L1 [label="h"];
  L1 -> L1a [label="g"];
  L1 -> M1 [label="z"];
  L1a -> L1 [label="h"];
  M1 -> a_K2 [label="cross"];
  
  // --- SubAutomaton ---
  a1 [label="a1"]; a2 [label="a2"];
  a3 [shape="doublecircle", fillcolor=lightblue, label="a3"]; a4 [shape="doublecircle", fillcolor=lightblue,label="a4"]; 
  a1 -> a1 [label="ε"];
  a1 -> a2 [label="v"];
  a2 -> a4 [label="z"];
  a4 -> a1 [label="u"];
  a2 -> a3 [label="g"];
  a3 -> a2 [label="i"];
  
}