digraph G {
  rankdir=LR;
  node [fontname="Arial", style=filled]; // Standaard stijl voor alle knopen
  
  // --- REGIO 1 ---
  node [fillcolor="white"]; 
  
  __start0 [label="" shape=none width=0 height=0];
  __start0 -> a_B1 [label="entry"];
  
  F1 [shape="doublecircle"]
  
  a_B1 [label="B1"];
  a_C1 [label="C1"]; 
  a_D1 [label="D1"];
  a_E1 [label="E1"]; 
  a_F1 [label="F1"];
  a_G1 [label="G1"]; 
  
  a_B1 -> a_C1 [label="v"];
  a_C1 -> a_D1 [label="z"];
  a_C1 -> a_E1 [label="w"];
  a_D1 -> a_F1 [label="i"];
  a_E1 -> a_G1 [label="i"];
  a_F1 -> F1 [label="#"];
  a_G1 -> F1 [label="@"];
  a_B1 -> a_B1 [label="ε"];
  
  // --- REGIO 2 ---
  node [fillcolor="white"];  
  
  __start1 [label="" shape=none width=0 height=0];
  __start1 -> a_K1 [label="entry"];
  
  F2 [shape="doublecircle"]
  
  a_K1 [label="K1"];
  a_L1 [label="L1"]; 
  a_M1 [label="M1"];
  a_N1 [label="N1"]; 
  a_O1 [label="O1"];
  a_P1 [label="P1"]; 
  
  a_K1 -> a_L1 [label="v"];
  a_L1 -> a_M1 [label="z"];
  a_L1 -> a_N1 [label="w"];
  a_M1 -> a_O1 [label="i"];
  a_N1 -> a_P1 [label="i"];
  a_O1 -> F2 [label="$"];
  a_P1 -> F2 [label="/"];
  a_K1 -> a_K1 [label="ε"];
  
  
  // --- SubAutomaton ---
  node [fillcolor="grey"];  
  
  __start2 [label="" shape=none width=0 height=0];
  __start2 -> a1 [label="RC call"];
  
  a1 [label="a1"]; a2 [label="a2"];
  a3 [shape="doublecircle" label="a3"]; a4 [shape="doublecircle" label="a4"];
  
  a1 -> a1 [label="ε"];
  a1 -> a2 [label="v"]
  a2 -> a3 [label="z"]
  a2 -> a4 [label="w"]
  
  
  
 // --- Refactored Nondeterminism---
 node [fillcolor="yellow"];
 __start3 [label="" shape=none width=0 height=0];
 __start3 -> a_sub1 [label="RC call"];
 a_sub1 [shape="box"]; a_sub2 [label="F1"];
 a_sub3 [label="G1"]; a_sub4 [shape="doublecircle"label="F1"];
 
 a_sub1 -> a_sub2 [label="i"];
 a_sub1 -> a_sub3 [label="i"];
 a_sub2 -> a_sub4 [label="$"];
 a_sub3 -> a_sub4 [label="/"];
 
 node [fillcolor="red"];
 a_sub11 [shape="box"]; a_sub12 [label="O1"];
 a_sub13 [label="P1"]; a_sub14 [shape="doublecircle"label="F2"];
 __start4 [label="" shape=none width=0 height=0];
 __start4 -> a_sub11 [label="RC call"];

 a_sub11 -> a_sub12 [label="i"];
 a_sub11 -> a_sub13 [label="i"];
 a_sub12 -> a_sub14 [label="$"];
 a_sub13 -> a_sub14 [label="/"];
 

}